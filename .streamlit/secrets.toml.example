# Copy to secrets.toml locally; paste real values into Streamlit Cloud Secrets.
# Never commit secrets.toml.
ADMIN_USERNAME = "chairman"
ADMIN_PASSWORD = "REPLACE_WITH_A_LONG_UNIQUE_PASSWORD"
ATTENDANCE_TIMEZONE = "Asia/Karachi"
UNIVERSITY_NAME = "Campus Intelligence"
# Optional supervised station code. Omit to require a staff login.
# KIOSK_ACCESS_CODE = "REPLACE_WITH_A_LONG_UNIQUE_STATION_CODE"
SPEAKER_VERIFICATION_THRESHOLD = 0.5962
# Required for durable cloud records. Use Supabase's session pooler URL and TLS.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
